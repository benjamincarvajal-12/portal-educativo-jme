rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isStaff() {
      return signedIn() && userRole() in ['admin', 'director', 'preceptor'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == 'alumno'
          && (
            request.resource.data.email == request.auth.token.email
            || (request.resource.data.email == ''
              && request.resource.data.keys().hasAll(['username'])
              && request.resource.data.username is string
              && request.resource.data.username.matches('^[a-z0-9._-]{3,30}$')
              && request.auth.token.email == 'jme.' + request.resource.data.username + '@login.portal-jme.invalid')
            || (request.resource.data.email == ''
              && request.resource.data.loginId == request.auth.token.email)
          ))
        || (isAdmin() && request.resource.data.role in ['admin', 'director', 'preceptor', 'alumno'])
      );
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'fullName', 'updatedAt']));
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if settingId == 'portal' && (isAdmin() || (signedIn() && userRole() == 'director'));
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /contacts/{contactId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /queries/{queryId} {
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow read: if signedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /attendance/{weekId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
  }
}
